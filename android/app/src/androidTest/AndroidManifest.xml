<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Lives in the test APK's separate UID; never present in a release APK. -->
        <activity android:name="com.codedbydan.momentum.ClipboardRecipientActivity"
            android:label="Disposable notes recipient" android:exported="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
