<?xml version="1.0" encoding="UTF-8"?>
<!-- Dan Hart 2026 <race-unbent-water@duck.com> -->
<component type="desktop-application">
  <id>@app-id@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Momentum</name>
  <summary>Plan your day</summary>
  <description>
    <p>Momentum is a task planner for GNOME. Plan what you will do today, keep projects and tags tidy, and get out of the way.</p>
    <p>Keep tasks available offline and optionally sync your devices through Nextcloud or LibreSync.</p>
    <ul>
      <li>Today, project and tag views</li>
      <li>Guided task creation with due day, estimate, tags and notes</li>
      <li>Nextcloud sync and backup import</li>
      <li>Keyboard first, with system-wide shortcuts</li>
      <li>Adaptive layout for phones and desktops</li>
    </ul>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/dan-hart/momentum/v0.4.15/data/resources/screenshots/today.png</image>
      <caption>Today view with projects and tags in the sidebar</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/dan-hart/momentum/v0.4.15/data/resources/screenshots/coming-up.png</image>
      <caption>Coming Up: the next days grouped by day</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/dan-hart/momentum/v0.4.15/data/resources/screenshots/new-task.png</image>
      <caption>Creating a task with a due day, time, reminder, estimate and tags</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/dan-hart/momentum/v0.4.15/data/resources/screenshots/devices.png</image>
      <caption>Sync with nearby devices: link once with a pairing code, no server needed</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/dan-hart/momentum</url>
  <url type="bugtracker">https://github.com/dan-hart/momentum/issues</url>
  <url type="vcs-browser">https://github.com/dan-hart/momentum</url>
  <url type="translate">https://github.com/dan-hart/momentum/tree/main/po</url>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.4.15" date="2026-10-23">
      <description>
        <p>Fix macOS updater signing and prevent launch crashes.</p>
        <ul>
          <li>Fix the macOS launch crash introduced by the updater framework: official releases now require consistent Developer ID signing and notarization while retaining hardened runtime and library validation.</li>
          <li>Reject invalid nested code signatures and debugging entitlements, exercise the extracted release archive before publication, and clean private signing material even when an operating-system cleanup step fails.</li>
        </ul>
      </description>
    </release>
    <release version="0.4.14" date="2026-10-23">
      <description>
        <p>Desktop updates and safer Apple build tooling.</p>
        <ul>
          <li>Desktop Updates settings with optional automatic checks, Homebrew-aware macOS upgrades, signed Sparkle updates for direct downloads, and Flatpak update monitoring.</li>
          <li>Native Linux Software shortcuts for immediate update checks and clear installation, cancellation, and restart guidance.</li>
          <li>Prevent ambiguous package ownership, cancelled subprocesses, stale installation receipts, and overlapping restarts from producing unsafe or misleading updates.</li>
          <li>Isolate documented Apple build commands from unrelated shell credentials and disable script-environment logging. Protect generated build logs and update feeds.</li>
        </ul>
      </description>
    </release>
    <release version="0.4.13" date="2026-10-23">
      <description>
        <p>Faster native sync with efficient transfers and optional optimized Nextcloud collections.</p>
        <ul>
          <li>Faster sync scheduling on Linux, macOS, iOS and Android: bounded 750 ms edit coalescing, prompt follow-ups, and adaptive foreground reconciliation.</li>
          <li>Reused HTTP connections, validated conditional downloads across restarts, parallel optional settings exchanges, and less processing during unchanged idle polls.</li>
          <li>An explicit per-connection optimized Nextcloud upgrade with smaller operation uploads, periodic checkpoints, separate archives and an encrypted key envelope. Upgrade every participating device; legacy sync remains the default and the original files are retained. Downgrade requires a verified migration flow.</li>
          <li>Optional foreground Nextcloud Client Push with secure discovery and polling fallback.</li>
          <li>Preserve offline edits, restore/undo state, conflict handling and copied collections through optimized exchanges and interrupted publication.</li>
          <li>Contain Android credential failures and prevent stopped sync providers restarting background listeners. Avoid sensitive dependency logging and persisted secret hashes.</li>
        </ul>
      </description>
    </release>
    <release version="0.4.12" date="2026-10-22">
      <description>
        <p>A calmer day view, searchable settings, and clearer completion feedback.</p>
        <ul>
          <li>Settings are organized into native categories with search, settings results in task search, and a richer About view on Linux, macOS, iOS and Android.</li>
          <li>Optional encouraging completion messages, 100 English/German choices, and a manual Celebrate button with a colorful confetti/starburst and a reduced-motion alternative.</li>
          <li>A local option to keep Morning/Evening tasks out of Today, with remaining-task counts and links to the appropriate period.</li>
          <li>Ten new short completion sounds, independent previews, and a local volume control.</li>
          <li>Morning &amp; Night grouping uses sun/moon headings and spacing only for populated sections. Linux task entry now simply says “Add a task”.</li>
          <li>Celebrate icon and label contrast follows the actual button fill, including pressed states, across supported native appearances.</li>
          <li>Hidden-period ordering, completion eligibility, archived-period navigation, and stale completed-state claims retain accurate task scope.</li>
          <li>German Settings/About catalog coverage and Linux backup action-row compatibility.</li>
        </ul>
      </description>
    </release>
    <release version="0.4.11" date="2026-10-13">
      <description>
        <p>Fix task entry and navigation, add recurring previews and optional settings transfer and sync.</p>
        <ul>
          <li>Ten short CC0 task-completion sounds to choose and preview on Linux, macOS, iOS and Android. Sound stays off by default; when enabled, the default choice is 6 · Bright Finish.</li>
          <li>Native Android app in Kotlin and Jetpack Compose with the shared Rust core: offline tasks, organization, search, recurrence, reminders, optional Nextcloud/LibreSync, Android Keystore, private drafts and SAF backups. Native parity and physical accessibility acceptance remain in progress.</li>
          <li>Android APK/AAB, matching source, dependency notices, R8 mapping and provenance in the unified tagged release, with optional distribution signing and explicit unsigned filenames otherwise. Release checksums cover all distribution assets. No store upload.</li>
          <li>Optional app-settings import/export, including an independent unchecked option on task backups, and settings-only files. Credentials and device controls stay local.</li>
          <li>Optional settings sync over the selected Nextcloud or LibreSync connection, with explicit initial-device choices and durable retry after interrupted exchanges.</li>
          <li>Read-only future recurring occurrences in Upcoming, with Edit repeat schedule.</li>
          <li>An opt-in, verified Nextcloud folder copy to momentum that retains the original.</li>
          <li>Overdue tasks show a labeled callout and date across the native apps.</li>
          <li>Copy Notes confirms success inside the editor, with native Apple/Android feedback.</li>
          <li>Momentum owns its crate names, URL entry points and customer-facing naming while preserving existing task, backup and sync formats and required license notices.</li>
          <li>Linux task entry has concise guidance with a native tooltip and accessibility text.</li>
          <li>Linux: project selection in the task editor now displays and saves the selected ID, including duplicate project names. Preferences fits independently of a short parent.</li>
          <li>iOS: the first project selection from Lists loads its tasks without a second tap.</li>
          <li>iOS: share-sheet tasks capture Today when added, retaining that day across a delayed import or timezone change.</li>
          <li>Fresh Nextcloud stores can create the required initial configuration safely.</li>
          <li>Damaged task stores fail visibly before a network exchange instead of opening empty.</li>
          <li>Folder-copy cancellation retains the original connection, including a late cancel, and resumes automatic sync after cancellation.</li>
          <li>Release-profile verification uses the runner's isolated test schema consistently; production and development settings remain separate.</li>
        </ul>
      </description>
    </release>
    <release version="0.4.10" date="2026-10-13">
      <description>
        <p>Fix task entry and navigation, add recurring previews and optional settings transfer and sync.</p>
        <ul>
          <li>Ten short CC0 task-completion sounds to choose and preview on Linux, macOS, iOS and Android. Sound stays off by default; when enabled, the default choice is 6 · Bright Finish.</li>
          <li>Native Android app in Kotlin and Jetpack Compose with the shared Rust core: offline tasks, organization, search, recurrence, reminders, optional Nextcloud/LibreSync, Android Keystore, private drafts and SAF backups. Native parity and physical accessibility acceptance remain in progress.</li>
          <li>Android APK/AAB, matching source, dependency notices, R8 mapping and provenance in the unified tagged release, with optional distribution signing and explicit unsigned filenames otherwise. Release checksums cover all distribution assets. No store upload.</li>
          <li>Optional app-settings import/export, including an independent unchecked option on task backups, and settings-only files. Credentials and device controls stay local.</li>
          <li>Optional settings sync over the selected Nextcloud or LibreSync connection, with explicit initial-device choices and durable retry after interrupted exchanges.</li>
          <li>Read-only future recurring occurrences in Upcoming, with Edit repeat schedule.</li>
          <li>An opt-in, verified Nextcloud folder copy to momentum that retains the original.</li>
          <li>Overdue tasks show a labeled callout and date across the native apps.</li>
          <li>Copy Notes confirms success inside the editor, with native Apple/Android feedback.</li>
          <li>Momentum owns its crate names, URL entry points and customer-facing naming while preserving existing task, backup and sync formats and required license notices.</li>
          <li>Linux task entry has concise guidance with a native tooltip and accessibility text.</li>
          <li>Linux: project selection in the task editor now displays and saves the selected ID, including duplicate project names. Preferences fits independently of a short parent.</li>
          <li>iOS: the first project selection from Lists loads its tasks without a second tap.</li>
          <li>iOS: share-sheet tasks capture Today when added, retaining that day across a delayed import or timezone change.</li>
          <li>Fresh Nextcloud stores can create the required initial configuration safely.</li>
          <li>Damaged task stores fail visibly before a network exchange instead of opening empty.</li>
          <li>Folder-copy cancellation retains the original connection, including a late cancel, and resumes automatic sync after cancellation.</li>
        </ul>
      </description>
    </release>
    <release version="0.4.9" date="2026-10-10">
      <description>
        <p>Faster sync with safer retries and recovery</p>
        <ul>
          <li>Sync: unchanged Nextcloud files use conditional requests and a small durable metadata update. Controlled tests measured 11.6× faster idle engine exchanges with 10,000 tasks</li>
          <li>LibreSync: queued offline changes are published in one durable journal batch; the 1,000-operation test measured 244× faster publication</li>
          <li>Sync: retry transient download and verification failures within the exchange deadline, while retaining local edits when an upload or journal write cannot be verified</li>
          <li>Sync: detect same-version remote replacements and damaged compressed copies; improve English and German recovery messages across the native apps</li>
          <li>LibreSync: failed journal receipts and snapshots stay retryable instead of suppressing later delivery</li>
          <li>iOS: after a background sync wake, automatic sync could stop until the next edit or pull-to-refresh, so remote changes stayed out of sight; opening the app during a wake now retries at once and the idle cycle is re-armed. A wake that runs out of its time budget no longer shows as a sync failure</li>
          <li>macOS and Linux: with background sync on, bringing the window back now redraws the list and syncs when the idle cycle was missed while hidden; macOS keeps its background sync timers on cadence by declining App Nap while syncing without a window</li>
        </ul>
      </description>
    </release>
    <release version="0.4.8" date="2026-10-07">
      <description>
        <p>Share a link or text to Momentum from any iOS app.</p>
        <ul>
          <li>iOS: share a link or text to Momentum from any app's share sheet. The sheet shows a normalized title to edit and adds the task to Inbox with the link first in its notes when Momentum next opens; the app and its extension now share an App Group</li>
        </ul>
      </description>
    </release>
    <release version="0.4.7" date="2026-10-06">
      <description>
        <p>Optional task-completion sound controlled by a setting, off by default.</p>
        <ul>
          <li>Optional task-completion sound, off by default, in Linux Preferences, macOS Settings and iOS Settings. A short bundled chime plays for completion; reopen and undo are silent.</li>
        </ul>
      </description>
    </release>
    <release version="0.4.6" date="2026-10-02">
      <description>
        <p>Optional Apple Reminders import on macOS and iOS, with reliable import recovery.</p>
        <ul>
          <li>macOS and iOS: optional one-way import from a selected Apple Reminders list, with manual import and off-by-default automatic import while Momentum is active</li>
          <li>Apple Reminders: prevent a crash when EventKit returns reminders on a background queue</li>
          <li>Apple Reminders: retry failed fetches and saves, announce import results to assistive technology, and retain newly discovered reminder identities to avoid duplicate imports</li>
          <li>README and screenshot notes refreshed: October 2026 previews of all three apps, the current platform status, what changed in 0.4, and how sync failures and recovery work</li>
          <li>Linux: MOMENTUM_SCREENSHOT_SIZE=WIDTHxHEIGHT sizes a capture, and captures render as the active window even when launched from a terminal</li>
        </ul>
      </description>
    </release>
    <release version="0.4.5" date="2026-10-01">
      <description>
        <ul>
          <li>macOS: completing the last task of Today (with completed tasks archived immediately) could crash the app while the list emptied; the list now stays in place and shows the empty state over it, and its sections keep stable identities across updates</li>
          <li>Linux: closing the window no longer aborts the process when it is finalized</li>
        </ul>
      </description>
    </release>
    <release version="0.4.4" date="2026-09-30">
      <description>
        <ul>
          <li>Sync: an upload cut off by a slow connection could be stored by the server as the sync file and lock every device out. Uploads now carry a checksum and expected length, the stored size is checked afterwards, and a partial copy is reported instead of trusted</li>
          <li>Sync: a large sync file over a slow or relayed connection no longer fails at 30 s; a foreground exchange may take up to five minutes while stalls still fail fast</li>
          <li>Sync: a damaged server copy is told apart from a wrong encryption password</li>
          <li>Every platform: sync failures are explained in plain words with what to do next; the technical message stays behind Details</li>
          <li>Every platform: Replace Server Copy publishes this device's tasks over a damaged server copy (kept as sync-data.json.damaged) after confirmation; mo sync --replace-remote does the same from the command line</li>
          <li>iOS: the sync failure section shows "Trying again…" and "Last tried" so Try Again is visibly acknowledged</li>
        </ul>
      </description>
    </release>
    <release version="0.4.3" date="2026-09-29">
      <description>
        <ul>
          <li>iOS: pull down any list to reload it and run one exchange with the selected sync provider</li>
          <li>iOS: View Options on every list (the ••• menu) with Group By, Sort By, Order and, in Upcoming, the 7/30-day range; Settings › Task Lists keeps the same choices</li>
          <li>iOS: View Options › Layout offers Regular and Compact task rows; Regular rows are also a little tighter than before</li>
          <li>iOS: Settings › Sync has a Background section with the "Sync in the background" switch</li>
          <li>Every platform: the task context menu's Move To submenu offers the two days after tomorrow by their weekday names ("Wednesday", "Thursday")</li>
          <li>iOS: on an iPhone wide enough in landscape, the lists sidebar sits beside the task list</li>
          <li>Linux and macOS: View Options › Layout offers Regular and Compact task rows</li>
          <li>iOS: the floating Add task control is a round plus button; it keeps the "Add task" accessibility label, a 44 pt target, Dynamic Type scaling and the Large Content Viewer</li>
          <li>iOS: a sync status badge in every list's navigation bar (spinner while syncing, the provider symbol in the accent color, orange when attention is needed) opens Settings › Sync; the text status at the end of the list stays and now sits closer under the last task</li>
          <li>Every platform: Morning &amp; Night grouping shows Morning first, then Today, then Evening</li>
          <li>Every platform: sync runs twice as often: edits upload 10 s after they settle and an idle app polls every 150 s; iOS background wakes may come every 15 minutes</li>
          <li>iOS: navigation bars are Liquid Glass again; lists scroll underneath with the system's soft edge effect instead of an opaque header</li>
          <li>iOS: pull to refresh is available only while a sync provider is selected</li>
        </ul>
      </description>
    </release>
    <release version="0.4.2" date="2026-09-28">
      <description>
        <p>Grouped context menus with Move To on Linux and iOS, and background sync on every platform.</p>
        <ul>
          <li>Linux: Preferences › Desktop › "Sync in the background" decides whether automatic sync keeps running while the window is closed; Sync Now always works</li>
          <li>iOS: Settings › Sync › "Sync in the background" lets iOS wake Momentum occasionally for one bounded Nextcloud exchange; Low Power Mode and the connection's automatic switch still apply</li>
          <li>Linux and iOS: the task context menu is grouped, with every Move to destination (Morning, Tonight, Tomorrow, Next Week, Project) in one Move To submenu; on Linux the menu now acts on the whole selection when the clicked row is selected</li>
          <li>Linux: the empty search screen says "Search"; iOS: the search prompt is "Search"</li>
          <li>iOS: Settings › Task Lists notes that Upcoming is always grouped by day</li>
        </ul>
      </description>
    </release>
    <release version="0.4.1" date="2026-09-28">
      <description>
        <p>Coming Up by day, a customizable Mac toolbar, background sync control and one main window.</p>
        <ul>
          <li>macOS: View › Customize Toolbar… rearranges, removes and restores the toolbar's items (New Task, Sync Now, View Options, plus optional Quick Add and Archive Completed)</li>
          <li>macOS: Settings › Sync › "Sync in the background" decides whether automatic sync keeps running while Momentum has no window open; Sync Now always works</li>
          <li>Coming Up is always one section per day — Tomorrow, then the weekday names of this week, then dates — on every platform; Group By is disabled while it is showing, and its rows no longer repeat the day the heading names</li>
          <li>macOS: dragging a selected task lifts and moves the whole selection, one item per task</li>
          <li>macOS: the task context menu is grouped, with every Move to destination (Morning, Tonight, Tomorrow, Next Week, Project…) in one Move To submenu</li>
          <li>macOS: the search field and empty search screen say "Search"</li>
          <li>The Linux and macOS apps' iOS sibling now carries the same version and build number</li>
          <li>macOS: clicking the Dock icon while the app ran without a window could open two main windows; the main window is now a single-instance scene</li>
        </ul>
      </description>
    </release>
    <release version="0.4.0" date="2026-09-23">
      <description>
        <p>Auto-archive, Linux desktop parity, and one release for every platform.</p>
        <ul>
          <li>Preferences › Tasks › "Archive completed tasks immediately": a completed task goes straight to the archive and syncs; undo brings it back open</li>
          <li>Linux desktop parity: a native font chooser with independent content/interface scaling, exact task reveal through mo open, GApplication actions and task URLs, plus configurable Background Apps task-count modes</li>
          <li>One release process for every platform: build-aux/release.py keeps one version across the Rust workspace, the GTK app, the macOS app, the metainfo and this changelog, and a single Release workflow runs every test against the tag, then publishes the GitHub Release with the Flatpak bundles, the macOS app and mo for macOS and Linux, updates the Homebrew tap (momentum cask, momentum-cli formula), the signed Flatpak repository, and the Flathub manifest</li>
          <li>The macOS app's version now follows the workspace instead of its own number</li>
        </ul>
      </description>
    </release>
    <release version="0.3.5" date="2026-09-15">
      <description>
        <p>Mornings.</p>
        <ul>
          <li>A Morning section and view for tasks tagged "Morning", the mirror of Tonight: Ctrl+Shift+M, context menu, drop target</li>
          <li>Morning and Tonight appear in the sidebar only on days that use them</li>
          <li>mo morning and mo add --morning</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-09-15">
      <description>
        <p>Your modifier key, and a test suite behind every feature.</p>
        <ul>
          <li>Choose Ctrl, Alt or Super for every shortcut; the shortcuts overlay and hints follow</li>
          <li>Deleting and reordering tasks can now be undone with Ctrl+Z</li>
          <li>Editing a task scheduled at a time keeps its day; restored tasks no longer duplicate subtask links</li>
          <li>mo: undone and rm find completed tasks, projects and tags support --json, works without a session bus</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-09-14">
      <description>
        <p>Sync without a server, and tasks with a time.</p>
        <ul>
          <li>Sync with nearby devices: direct, end-to-end encrypted sync over the local network, linked once with a pairing code; works alongside Nextcloud</li>
          <li>Scheduled times and reminders in the task dialog; rows show the time and a bell</li>
          <li>Overdue section at the top of Today; repeating tasks catch up on missed days</li>
          <li>Accessibility pass: every control named for screen readers, high contrast turns color coding off</li>
          <li>Translation template and Weblate workflow</li>
        </ul>
      </description>
    </release>
    <release version="0.1.5" date="2026-09-09">
      <description>
        <p>Momentum becomes part of the desktop.</p>
        <ul>
          <li>Find and create tasks from GNOME's Activities overview and KDE's KRunner</li>
          <li>Reminders with Done and Snooze buttons, and a morning summary</li>
          <li>Run in the background with autostart and a Background Apps status line</li>
          <li>Launcher actions, a quick-add window, drop or paste text to create tasks</li>
          <li>Command line, momentum:// links, Ctrl+Z undo</li>
          <li>The mo command-line companion for Linux and macOS</li>
          <li>German translation</li>
        </ul>
      </description>
    </release>
    <release version="0.1.1" date="2026-09-09">
      <description>
        <p>Repeat schedules, smarter empty states, and quicker sync.</p>
        <ul>
          <li>Create, edit, pause and remove repeat schedules, including monthly on the nth weekday</li>
          <li>Empty states that say what to do next, and an all-done panel with Archive Completed</li>
          <li>Move to Next Week, notes copy button and badge, larger notes editor</li>
          <li>Sync runs 20 seconds after your last change; sidebar toggle; context menu grouping</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-09-08">
      <description>
        <p>First preview.</p>
        <ul>
          <li>Today, project and tag views with a guided New Task dialog</li>
          <li>Nextcloud task sync with conflict recovery</li>
          <li>Backup import and export</li>
          <li>System-wide shortcuts through the GlobalShortcuts portal</li>
        </ul>
      </description>
    </release>
  </releases>
  <developer id="io.github.dan_hart">
    <name translate="no">Dan Hart</name>
  </developer>
  <branding>
    <color type="primary" scheme_preference="light">#ffbe6f</color>
    <color type="primary" scheme_preference="dark">#c64600</color>
  </branding>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <update_contact>race-unbent-water@duck.com</update_contact>
  <translation type="gettext">@gettext-package@</translation>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
</component>
