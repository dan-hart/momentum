<?xml version="1.0" encoding="utf-8"?>
<schemalist>
  <schema path="/io/github/dan_hart/Momentum/" id="@app-id@" gettext-domain="@gettext-package@">
    <key name="window-width" type="i">
      <default>600</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>400</default>
      <summary>Window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="nextcloud-server" type="s"><default>''</default><summary>Nextcloud server URL</summary></key>
    <key name="nextcloud-user" type="s"><default>''</default><summary>Nextcloud username</summary></key>
    <key name="nextcloud-folder" type="s"><default>'super-productivity'</default><summary>Sync folder on Nextcloud</summary></key>
    <key name="auto-sync" type="b"><default>true</default><summary>Sync automatically</summary></key>
    <key name="compress" type="b"><default>false</default><summary>Gzip the sync file</summary></key>
    <key name="projects-collapsed" type="b"><default>false</default><summary>Projects section collapsed in the sidebar</summary></key>
    <key name="tags-collapsed" type="b"><default>false</default><summary>Tags section collapsed in the sidebar</summary></key>
    <key name="task-sort" type="s">
      <choices><choice value="manual"/><choice value="title"/><choice value="due"/><choice value="estimate"/><choice value="created"/></choices>
      <default>'manual'</default>
      <summary>Task list sort order</summary>
    </key>
    <key name="colorful-labels" type="b"><default>true</default><summary>Colour-code projects and tags</summary></key>
    <key name="last-sync-ms" type="x"><default>0</default><summary>Time of the last successful sync (ms since epoch)</summary></key>
    <key name="sync-enabled" type="b"><default>false</default><summary>Nextcloud sync switched on</summary></key>
    <key name="sort-direction" type="s">
      <choices><choice value="ascending"/><choice value="descending"/></choices>
      <default>'ascending'</default>
      <summary>Task sort direction</summary>
    </key>
    <key name="upcoming-range" type="s">
      <choices><choice value="7"/><choice value="30"/></choices>
      <default>'7'</default>
      <summary>Days shown in Coming Up</summary>
    </key>
  </schema>
</schemalist>
