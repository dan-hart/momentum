<?xml version="1.0" encoding="utf-8"?>
<schemalist>
  <schema path="/io/github/dan_hart/Momentum/" id="@app-id@" gettext-domain="@gettext-package@">
    <key name="window-width" type="i">
      <default>600</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>400</default>
      <summary>Window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="nextcloud-server" type="s"><default>''</default><summary>Nextcloud server URL</summary></key>
    <key name="nextcloud-user" type="s"><default>''</default><summary>Nextcloud username</summary></key>
    <key name="nextcloud-folder" type="s"><default>'super-productivity'</default><summary>Sync folder on Nextcloud</summary></key>
    <key name="auto-sync" type="b"><default>true</default><summary>Sync automatically</summary></key>
    <key name="compress" type="b"><default>false</default><summary>Gzip the sync file</summary></key>
    <key name="projects-collapsed" type="b"><default>false</default><summary>Projects section collapsed in the sidebar</summary></key>
    <key name="tags-collapsed" type="b"><default>false</default><summary>Tags section collapsed in the sidebar</summary></key>
    <key name="group-by" type="s">
      <choices><choice value="morning-night"/><choice value="none"/><choice value="project"/><choice value="tag"/><choice value="estimate"/></choices>
      <default>'morning-night'</default>
      <summary>Group tasks by time of day, project, first tag, or time estimate</summary>
    </key>
    <key name="task-sort" type="s">
      <choices><choice value="manual"/><choice value="title"/><choice value="due"/><choice value="estimate"/><choice value="created"/></choices>
      <default>'manual'</default>
      <summary>Task list sort order</summary>
    </key>
    <key name="colorful-labels" type="b"><default>true</default><summary>Color-code projects and tags</summary></key>
    <key name="typography-font" type="s"><default>''</default><summary>Optional application font description without a size</summary></key>
    <key name="typography-content-scale" type="i"><range min="75" max="250"/><default>100</default><summary>Task content text scale in percent</summary></key>
    <key name="typography-interface-scale" type="i"><range min="75" max="250"/><default>100</default><summary>Application interface text scale in percent</summary></key>
    <key name="last-sync-ms" type="x"><default>0</default><summary>Time of the last successful sync (ms since epoch)</summary></key>
    <key name="sync-method" type="s">
      <choices><choice value=""/><choice value="off"/><choice value="nextcloud"/><choice value="libresync"/></choices>
      <default>''</default>
      <summary>Selected sync provider (empty retains the legacy preference)</summary>
    </key>
    <key name="sync-enabled" type="b"><default>false</default><summary>Nextcloud sync switched on</summary></key>
    <key name="sort-direction" type="s">
      <choices><choice value="ascending"/><choice value="descending"/></choices>
      <default>'ascending'</default>
      <summary>Task sort direction</summary>
    </key>
    <key name="upcoming-range" type="s">
      <choices><choice value="7"/><choice value="30"/></choices>
      <default>'7'</default>
      <summary>Days shown in Coming Up</summary>
    </key>
    <key name="run-in-background" type="b"><default>false</default><summary>Keep running after the window closes</summary></key>
    <key name="background-count-mode" type="s">
      <choices><choice value="due-today"/><choice value="today-including-overdue"/><choice value="off"/></choices>
      <default>'due-today'</default>
      <summary>Task count shown in the Background Apps status</summary>
    </key>
    <key name="morning-summary-enabled" type="b"><default>false</default><summary>Show a daily morning summary</summary></key>
    <key name="morning-summary-hour" type="i"><range min="0" max="23"/><default>8</default><summary>Morning summary hour in local time</summary></key>
    <key name="morning-summary-minute" type="i"><range min="0" max="59"/><default>0</default><summary>Morning summary minute</summary></key>
    <key name="last-summary-day" type="s"><default>''</default><summary>Day the morning summary was last shown</summary></key>
    <key name="modifier-key" type="s">
      <choices><choice value="control"/><choice value="alt"/><choice value="super"/><choice value="option"/><choice value="command"/></choices>
      <default>'control'</default>
      <summary>Primary modifier for app shortcuts (Ctrl+E becomes Super+E with "super")</summary>
    </key>
    <key name="auto-archive" type="b"><default>false</default><summary>Move a task to the archive as soon as it is completed</summary></key>
    <key name="p2p-enabled" type="b"><default>false</default><summary>Sync directly with nearby devices over the local network</summary></key>
    <key name="last-p2p-ms" type="x"><default>0</default><summary>Time of the last exchange with a nearby device (ms since epoch)</summary></key>
  </schema>
</schemalist>
