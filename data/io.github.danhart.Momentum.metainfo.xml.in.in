<?xml version="1.0" encoding="UTF-8"?>
<!-- Dan Hart 2026 <race-unbent-water@duck.com> -->
<component type="desktop-application">
  <id>@app-id@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Momentum</name>
  <summary>Plan your day and track your time</summary>
  <description>
    <p>Momentum is a native GNOME task planner and time tracker that reads, writes and syncs the same data as Super Productivity, so you can use it alongside the desktop, Android and iOS apps.</p>
  </description>
  <screenshots>
    <screenshot type="default">
      <!-- FIXME Replace with a real screenshot hosted at a tagged commit URL -->
      <image>https://github.com/danhart/momentum/raw/main/data/resources/screenshots/screenshot1.png</image>
      <caption>Main window</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/danhart/momentum</url>
  <url type="bugtracker">https://github.com/danhart/momentum/issues</url>
  <url type="vcs-browser">https://github.com/danhart/momentum</url>
  <url type="translate">https://github.com/danhart/momentum/tree/main/po</url>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.1.0" date="2026-09-07">
      <description>
        <p>Project scaffold.</p>
      </description>
    </release>
  </releases>
  <developer id="io.github.danhart">
    <name translate="no">Dan Hart</name>
  </developer>
  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <update_contact>race-unbent-water@duck.com</update_contact>
  <translation type="gettext">@gettext-package@</translation>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
</component>
