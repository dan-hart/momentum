using Gtk 4.0;

ShortcutsWindow help_overlay {
  modal: true;

  ShortcutsSection {
    section-name: "shortcuts";
    max-height: 10;

    ShortcutsGroup {
      title: C_("shortcut window", "General");

      ShortcutsShortcut {
        title: C_("shortcut window", "Add Task");
        action-name: "app.add-task";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Search");
        action-name: "win.search";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Mark Task Done / Undone");
        action-name: "win.toggle-done";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Delete Task");
        action-name: "win.delete-task";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Select All Tasks");
        action-name: "win.select-all";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Plan Task for Today");
        action-name: "win.plan-today";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Move Task to Tonight / Today");
        action-name: "win.toggle-tonight";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Move Task to Tomorrow");
        action-name: "win.move-tomorrow";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Move Task to Next Week");
        action-name: "win.move-next-week";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Archive Completed Tasks");
        action-name: "win.archive-done";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Move Task Up / Down");
        accelerator: "<Control>Up <Control>Down";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Duplicate Task");
        action-name: "win.duplicate";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Copy Task Title");
        action-name: "win.copy-title";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Open Task Details");
        action-name: "win.open-focused";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Clear Selection");
        action-name: "win.select-none";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Repeat Schedule");
        action-name: "win.repeat";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Move Task to Project");
        action-name: "win.move-to";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Go to Sidebar Entry 1–9");
        accelerator: "<Alt>1...9";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "New Project");
        action-name: "app.new-project";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Sync Now");
        action-name: "app.sync";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Preferences");
        action-name: "app.preferences";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Show Shortcuts");
        action-name: "win.show-help-overlay";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Close Window");
        action-name: "window.close";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Quit");
        action-name: "app.quit";
      }
    }

    ShortcutsGroup {
      title: C_("shortcut window", "Navigation");

      ShortcutsShortcut {
        title: C_("shortcut window", "Focus the Quick-Add Box");
        action-name: "win.focus-add";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Show or Hide the Sidebar");
        action-name: "win.toggle-sidebar";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Next / Previous View");
        accelerator: "<Control>Page_Down <Control>Page_Up";
      }
    }

    ShortcutsGroup {
      title: C_("shortcut window", "System-wide (set in Settings → Keyboard)");

      ShortcutsShortcut {
        title: C_("shortcut window", "Add a Task from Anywhere");
        accelerator: "<Control><Alt>t";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Show Momentum");
        accelerator: "<Control><Alt>m";
      }
    }
  }
}
