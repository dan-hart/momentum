using Gtk 4.0;
using Adw 1;

menu primary_menu {
  section {
    item {
      label: _("_New Project…");
      action: "app.new-project";
    }

    item {
      label: _("_Sync Now");
      action: "app.sync";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("_About Momentum");
      action: "app.about";
    }
  }
}

menu view_menu {
  section {
    label: _("Sort By");

    item {
      label: _("Manual Order");
      action: "win.task-sort";
      target: "manual";
    }

    item {
      label: _("Title");
      action: "win.task-sort";
      target: "title";
    }

    item {
      label: _("Due Day");
      action: "win.task-sort";
      target: "due";
    }

    item {
      label: _("Estimate");
      action: "win.task-sort";
      target: "estimate";
    }

    item {
      label: _("Created");
      action: "win.task-sort";
      target: "created";
    }
  }

  section {
    label: _("Order");

    item {
      label: _("Ascending");
      action: "win.sort-direction";
      target: "ascending";
    }

    item {
      label: _("Descending");
      action: "win.sort-direction";
      target: "descending";
    }
  }

  section {
    label: _("Coming Up");

    item {
      label: _("Next 7 Days");
      action: "win.upcoming-range";
      target: "7";
    }

    item {
      label: _("Next 30 Days");
      action: "win.upcoming-range";
      target: "30";
    }
  }

  section {
    item {
      label: _("Edit Project or Tag…");
      action: "win.edit-context";
    }

    item {
      label: _("Delete Project or Tag…");
      action: "win.delete-context";
    }
  }

  section {
    item {
      label: _("Archive Completed Tasks");
      action: "win.archive-done";
    }
  }
}

template $MomentumWindow: Adw.ApplicationWindow {
  title: _("Momentum");
  default-width: 960;
  default-height: 640;
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      split_view.collapsed: true;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationSplitView split_view {
      min-sidebar-width: 220;
      max-sidebar-width: 300;

      sidebar: Adw.NavigationPage {
        title: _("Momentum");

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [end]
            MenuButton {
              icon-name: "open-menu-symbolic";
              menu-model: primary_menu;
              primary: true;
              tooltip-text: _("Main Menu");
            }
          }

          content: ScrolledWindow {
            hscrollbar-policy: never;

            child: ListBox sidebar_list {
              selection-mode: single;

              styles [
                "navigation-sidebar",
              ]
            };
          };

          [bottom]
          Box {
            orientation: vertical;
            spacing: 6;
            margin-start: 12;
            margin-end: 12;
            margin-top: 6;
            margin-bottom: 12;

            Button {
              action-name: "app.add-task";

              styles [
                "suggested-action",
                "pill",
              ]

              child: Adw.ButtonContent {
                icon-name: "list-add-symbolic";
                label: _("Create Task");
              };
            }
          }
        };
      };

      content: Adw.NavigationPage content_page {
        title: _("Today");

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [end]
            MenuButton {
              icon-name: "view-more-symbolic";
              menu-model: view_menu;
              tooltip-text: _("View Options");
            }

            [end]
            Button sync_button {
              icon-name: "view-refresh-symbolic";
              tooltip-text: _("Sync Now");
              action-name: "app.sync";
            }
          }

          [top]
          Adw.Banner banner {
            button-label: _("Preferences");
          }

          [top]
          Adw.Clamp search_clamp {
            visible: false;
            maximum-size: 720;
            margin-start: 12;
            margin-end: 12;
            margin-top: 6;
            margin-bottom: 6;

            child: SearchEntry search_entry {
              placeholder-text: _("Search tasks, notes, projects and tags");
            };
          }

          [top]
          Adw.Clamp add_clamp {
            maximum-size: 720;
            margin-start: 12;
            margin-end: 12;
            margin-top: 6;
            margin-bottom: 6;

            child: Entry add_entry {
              placeholder-text: _("Add a task…  #tag  1h 30m");
              primary-icon-name: "list-add-symbolic";
            };
          }

          content: ScrolledWindow {
            hscrollbar-policy: never;

            child: Adw.Clamp {
              maximum-size: 720;
              margin-start: 12;
              margin-end: 12;
              margin-bottom: 12;

              child: Box {
                orientation: vertical;

                Box task_box {
                  orientation: vertical;
                  spacing: 24;
                }

                Label sync_label {
                  visible: false;
                  margin-top: 12;
                  xalign: 0.5;

                  styles [
                    "dim-label",
                    "caption",
                  ]
                }

                Adw.StatusPage empty {
                  icon-name: "io.github.dan_hart.Momentum-symbolic";
                  title: _("Nothing here yet");
                  description: _("Add a task above, or sync with Nextcloud from Preferences.");
                  vexpand: true;
                }
              };
            };
          };
        };
      };
    };
  };
}
