using Gtk 4.0;
using Adw 1;

menu primary_menu {
  section {
    item {
      label: _("_New Project…");
      action: "app.new-project";
    }

    item {
      label: _("_Sync Now");
      action: "app.sync";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("_About Momentum");
      action: "app.about";
    }
  }
}

template $MomentumWindow: Adw.ApplicationWindow {
  title: _("Momentum");
  default-width: 960;
  default-height: 640;
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      split_view.collapsed: true;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationSplitView split_view {
      min-sidebar-width: 220;
      max-sidebar-width: 300;

      sidebar: Adw.NavigationPage {
        title: _("Momentum");

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [end]
            MenuButton {
              icon-name: "open-menu-symbolic";
              menu-model: primary_menu;
              primary: true;
              tooltip-text: _("Main Menu");
            }
          }

          content: ScrolledWindow {
            hscrollbar-policy: never;

            child: ListBox sidebar_list {
              selection-mode: single;

              styles [
                "navigation-sidebar",
              ]
            };
          };
        };
      };

      content: Adw.NavigationPage content_page {
        title: _("Today");

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [end]
            Button sync_button {
              icon-name: "emblem-synchronizing-symbolic";
              tooltip-text: _("Sync Now");
              action-name: "app.sync";
            }
          }

          [top]
          SearchBar search_bar {
            child: Adw.Clamp {
              maximum-size: 720;

              child: SearchEntry search_entry {
                placeholder-text: _("Filter tasks");
              };
            };
          }

          [top]
          Adw.Clamp {
            maximum-size: 720;
            margin-start: 12;
            margin-end: 12;
            margin-top: 6;
            margin-bottom: 6;

            child: Entry add_entry {
              placeholder-text: _("Add a task…  #tag  1h 30m");
              primary-icon-name: "list-add-symbolic";
            };
          }

          content: ScrolledWindow {
            hscrollbar-policy: never;

            child: Adw.Clamp {
              maximum-size: 720;
              margin-start: 12;
              margin-end: 12;
              margin-bottom: 12;

              child: Box {
                orientation: vertical;

                ListBox task_list {
                  selection-mode: none;

                  styles [
                    "boxed-list",
                  ]
                }

                Adw.StatusPage empty {
                  icon-name: "io.github.danhart.Momentum-symbolic";
                  title: _("Nothing here yet");
                  description: _("Add a task above, or sync with Nextcloud from Preferences.");
                  vexpand: true;
                }
              };
            };
          };
        };
      };
    };
  };
}
