using Gtk 4.0;
using Adw 1;

template $MomentumPrefs: Adw.PreferencesDialog {
  title: _("Preferences");

  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      title: _("Sync");
      description: _("Choose one service. Switching keeps your tasks and saved connections.");

      Adw.ComboRow method_row {
        title: _("Sync method");
        subtitle: _("Off by default. Nothing leaves this device until you turn it on.");
      }
    }

    Adw.PreferencesGroup nextcloud_group {
      title: _("Nextcloud");
      description: _("Shares the same sync-data.json as Super Productivity. Use the same folder and encryption password as your other devices.");

      Adw.EntryRow server_row {
        title: _("Server URL");
      }

      Adw.EntryRow user_row {
        title: _("Username");
      }

      Adw.PasswordEntryRow password_row {
        title: _("App password");
      }

      Adw.EntryRow folder_row {
        title: _("Sync folder");
      }

      Adw.PasswordEntryRow encrypt_row {
        title: _("Encryption password");
      }

      Adw.SwitchRow auto_row {
        title: _("Sync automatically");
        subtitle: _("At startup, every five minutes, and shortly after you make changes");
      }

      Adw.SwitchRow compress_row {
        title: _("Compress sync file");
      }

      Adw.ButtonRow {
        title: _("Sync Now");
        start-icon-name: "view-refresh-symbolic";
        action-name: "app.sync";
      }
    }

    Adw.PreferencesGroup nearby_group {
      title: _("LibreSync");
      description: _("Sync directly with linked devices on your network. Changes sync automatically while this service is selected.");

      Adw.ButtonRow {
        title: _("Manage Devices…");
        start-icon-name: "computer-symbolic";
        action-name: "app.devices";
      }

      Adw.ButtonRow {
        title: _("Sync Devices Now");
        start-icon-name: "view-refresh-symbolic";
        action-name: "app.sync-devices";
      }
    }

    Adw.PreferencesGroup {
      title: _("Tasks");

      Adw.SwitchRow auto_archive_row {
        title: _("Archive completed tasks immediately");
        subtitle: _("A completed task goes straight to the archive and syncs. Undo brings it back.");
      }
    }

    Adw.PreferencesGroup {
      title: _("Notifications");
      description: _("Summarize today's tasks once a day at this local time, or when Momentum next opens. Task reminders are separate.");

      Adw.SwitchRow morning_summary_row {
        title: _("Morning summary");
        subtitle: _("Off by default. Momentum must be running to send notifications.");
      }
      Adw.SpinRow morning_hour_row {
        title: _("Hour (0–23)");
        numeric: true;
        snap-to-ticks: true;
        adjustment: Gtk.Adjustment { lower: 0; upper: 23; step-increment: 1; page-increment: 1; };
      }
      Adw.SpinRow morning_minute_row {
        title: _("Minute");
        numeric: true;
        snap-to-ticks: true;
        adjustment: Gtk.Adjustment { lower: 0; upper: 59; step-increment: 1; page-increment: 5; };
      }
    }

    Adw.PreferencesGroup {
      title: _("Desktop");

      Adw.SwitchRow background_row {
        title: _("Run in the background");
        subtitle: _("Keep reminders and sync running after the window closes, and start at login");
      }

      Adw.ComboRow background_count_row {
        title: _("Background task count");
        subtitle: _("Choose which tasks appear in the Background Apps status");
      }

      Adw.ComboRow modifier_row {
        title: _("Modifier key");
        subtitle: _("The key in every shortcut, so Ctrl+E becomes Super+E. Combinations the desktop uses itself, such as Super+A on GNOME, do not reach Momentum.");
      }
    }

    Adw.PreferencesGroup {
      title: _("Appearance");

      Adw.SwitchRow colorful_row {
        title: _("Color-code projects and tags");
        subtitle: _("Use the colors from your Super Productivity data");
      }
    }

    Adw.PreferencesGroup {
      title: _("Typography");
      description: _("Use the system font by default, or choose an app font and independent relative sizes.");

      Adw.ActionRow {
        title: _("Font");
        subtitle: _("Applies to Momentum only; Reset Typography restores the system font");

        [suffix]
        Gtk.FontDialogButton font_button {
          valign: center;
          use-font: true;
          use-size: false;
          dialog: Gtk.FontDialog {
            title: _("Choose Font");
          };
        }
      }

      Adw.SpinRow content_scale_row {
        title: _("Content size");
        subtitle: _("Task titles, notes, and task entry, as a percentage of the system text size");
        numeric: true;
        snap-to-ticks: true;
        digits: 0;
        adjustment: Gtk.Adjustment { lower: 75; upper: 250; step-increment: 5; page-increment: 25; };
      }

      Adw.SpinRow interface_scale_row {
        title: _("Interface size");
        subtitle: _("Navigation, settings, headings, and controls, as a percentage of the system text size");
        numeric: true;
        snap-to-ticks: true;
        digits: 0;
        adjustment: Gtk.Adjustment { lower: 75; upper: 250; step-increment: 5; page-increment: 25; };
      }

      Adw.ButtonRow reset_typography_row {
        title: _("Reset Typography");
        start-icon-name: "edit-undo-symbolic";
      }
    }

    Adw.PreferencesGroup {
      title: _("Backup");

      Adw.ButtonRow {
        title: _("Import Backup JSON…");
        action-name: "app.import";
      }

      Adw.ButtonRow {
        title: _("Export Backup JSON…");
        action-name: "app.export";
      }
    }
  }
}
