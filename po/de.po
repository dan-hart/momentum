msgstr "Wähle eine lokale Datei"

#: crates/app/src/prefs.rs:655 crates/app/src/window.rs:4019
msgid "App settings saved"
msgstr "App-Einstellungen gespeichert"

#: crates/app/src/prefs.rs:657 crates/app/src/window.rs:4021
msgid "App settings imported"
msgstr "App-Einstellungen importiert"

#: crates/app/src/task_form.rs:326
