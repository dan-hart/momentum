#: data/io.github.dan_hart.Momentum.metainfo.xml.in.in:10
msgid ""
"Momentum is a task planner for GNOME. Plan what you will do today, keep "
"projects and tags tidy, and get out of the way."
msgstr ""

#: data/io.github.dan_hart.Momentum.metainfo.xml.in.in:11
msgid ""
"It reads, writes and syncs the same data as Super Productivity, so it works "
"alongside the desktop, Android and iOS apps through a shared Nextcloud "
"folder."
msgstr ""

#: data/io.github.dan_hart.Momentum.metainfo.xml.in.in:13
msgid "Today, project and tag views"
msgstr ""

#: data/io.github.dan_hart.Momentum.metainfo.xml.in.in:14
msgid "Guided task creation with due day, estimate, tags and notes"
msgstr ""

#: data/io.github.dan_hart.Momentum.metainfo.xml.in.in:15
msgid "Nextcloud sync and backup import"
msgstr ""

#: data/io.github.dan_hart.Momentum.metainfo.xml.in.in:16
msgid "Keyboard first, with system-wide shortcuts"
msgstr ""

#: data/io.github.dan_hart.Momentum.metainfo.xml.in.in:17
msgid "Adaptive layout for phones and desktops"
msgstr ""

#: data/io.github.dan_hart.Momentum.metainfo.xml.in.in:23
msgid "Today view with projects and tags in the sidebar"
msgstr ""

#: data/io.github.dan_hart.Momentum.metainfo.xml.in.in:27
msgid "Coming Up: the next days grouped by day"
msgstr ""

