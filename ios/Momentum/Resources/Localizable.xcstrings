      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherungen enthalten deine Aufgaben, Projekte, Tags und Wiederholungen. Bewahre eine Kopie an einem sicheren Ort auf."
          }
        }
      }
    },
    "Body text keeps its system color for readability.": {
