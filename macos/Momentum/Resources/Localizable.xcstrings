    "Content size": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schriftgröße für Inhalte"
          }
        }
      }
    },
    "Content size changes tasks, notes and task entry. Interface size changes navigation, settings and controls. The Fonts panel also sets content size.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Inhaltsgröße gilt für Aufgaben, Notizen und die Aufgabeneingabe. Die Oberflächengröße gilt für Navigation, Einstellungen und Bedienelemente. Die macOS-Schriftauswahl legt auch die Inhaltsgröße fest."
          }
        }
      }
    },
    "Copy Task Title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgabentitel kopieren"
