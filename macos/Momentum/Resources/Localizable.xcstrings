      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben erledigen"
          }
        }
      }
    },
    "Complete or reopen current tasks and return the number changed. Respects automatic archiving; archived tasks are read-only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Aufgaben erledigen oder wieder öffnen und die Anzahl der Änderungen zurückgeben. Berücksichtigt die automatische Archivierung; archivierte Aufgaben sind schreibgeschützt."
          }
        }
      }
    },
