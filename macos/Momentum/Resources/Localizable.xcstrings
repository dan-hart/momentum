    "Choose a family and style in the macOS Fonts panel. Changes appear immediately.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Schriftfamilie und Schriftschnitt in der macOS-Schriftauswahl. Änderungen werden sofort angezeigt."
          }
        }
      }
    },
    "Choose one service to keep your tasks in sync. Switching services keeps your tasks and saved connections.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Dienst zur Synchronisierung deiner Aufgaben. Beim Wechsel bleiben deine Aufgaben und gespeicherten Verbindungen erhalten."
          }
        }
      }
    },
