    "Create a Momentum task and return it to the next action. Supports #tags and estimates. An optional due date overrides the plan's date.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Momentum-Aufgabe erstellen und an die nächste Aktion übergeben. Unterstützt #Tags und Zeitschätzungen. Ein optionales Fälligkeitsdatum ersetzt das Datum der Planung."
          }
        }
      }
    },
    "Create a task in Momentum, planned for today. Supports #tags and estimates such as 30m.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt eine für heute geplante Aufgabe in Momentum. Unterstützt #Schlagwörter und Zeitschätzungen wie 30m."
          }
        }
      }
    },
