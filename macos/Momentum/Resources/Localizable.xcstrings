    "Counts unfinished tasks. Subtasks are included with their parent. The badge is hidden when the count is zero.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt unerledigte Aufgaben. Unteraufgaben werden mit ihrer übergeordneten Aufgabe gezählt. Bei null wird der Zähler ausgeblendet."
          }
        }
      }
    },
